# Copy this file to server/.env and fill in real values. NEVER commit .env
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staffsync

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-your-own-random-secret
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Needed only to create the very first HR admin on /setup
SETUP_KEY=replace-with-a-random-setup-key
# Organisation rules (attendance)
ORG_TIMEZONE=Asia/Kolkata
WORK_START=09:30
LATE_GRACE_MINUTES=15
# 0=Sunday ... 6=Saturday
WEEKEND_DAYS=0,6
# Comma-separated YYYY-MM-DD public holidays
HOLIDAYS=

# Set true only when frontend and backend are on DIFFERENT domains (needs HTTPS)
CROSS_SITE_COOKIES=false
